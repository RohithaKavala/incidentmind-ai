PROJECT_NAME="Nexora — AI Incident Intelligence Agent"

# PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexora
FALLBACK_TO_SQLITE=True
SQLITE_URL=sqlite+aiosqlite:///./nexora.db

# Hindsight Memory Engine Configuration
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=nexora-incident-intelligence

# AI / LLM Configuration (Optional: Agent has built-in high-fidelity reasoning engine out of the box)
LLM_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
